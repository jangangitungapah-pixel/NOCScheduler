# NOCScheduler public application metadata
NEXT_PUBLIC_APP_NAME=NOCScheduler

# Local Firebase Emulator Suite defaults. These demo values never point at live Firebase resources.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-nocscheduler.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-nocscheduler
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-nocscheduler.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo-nocscheduler
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true

# Server-side Firebase Admin project selection for local emulator usage.
FIREBASE_PROJECT_ID=demo-nocscheduler
